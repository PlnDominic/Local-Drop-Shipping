# ─── Supabase (public, browser-safe) ─────────────────────────────────────────
# The anon key is meant to be public; data access is enforced by RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Backend API (only if/when using the NestJS API layer) ────────────────────
# Defaults to /api/v1 when unset.
NEXT_PUBLIC_API_URL=https://api.your-domain.com/v1

# ─── Pre-launch waitlist ─────────────────────────────────────────────────────
# Optional. When set to a future date/time, the homepage shows a launch countdown.
# NEXT_PUBLIC_LAUNCH_DATE=2026-12-01T09:00:00Z

# ─── Business details (optional; shown on legal pages and receipts) ──────────
# NEXT_PUBLIC_SUPPORT_EMAIL=support@localdropshippinggh.com
# NEXT_PUBLIC_BUSINESS_LEGAL_NAME=Your Registered Business Name Ltd
# NEXT_PUBLIC_DPC_REGISTRATION=Your Data Protection Commission registration number

# ─── Receipt emails (optional; PDF download works without these) ─────────────
# Create a key at resend.com and verify your sending domain there.
# RESEND_API_KEY=re_xxxxxxxx
# RECEIPT_FROM_EMAIL=Local Drop Shipping GH <orders@localdropshippinggh.com>

# ─── Demo data (leave unset in production) ───────────────────────────────────
# Set to "true" only on a demo/dev site to show built-in sample products when the catalog is empty.
# NEXT_PUBLIC_SHOW_DEMO_PRODUCTS=true

# ─── Order & stock notifications (optional; each channel is skipped until configured) ─────────
# SECRET. Server only (never prefix with NEXT_PUBLIC_). Supabase > Project Settings > API > service_role.
# SUPABASE_SERVICE_ROLE_KEY=
# Optional: lets a scheduler (e.g. cron-job.org) call /api/notifications/dispatch to retry failed sends.
# CRON_SECRET=a-long-random-string
# Email uses the same RESEND_API_KEY / RECEIPT_FROM_EMAIL as receipts.
# SMS (default Arkesel, popular in Ghana):
# SMS_PROVIDER=arkesel
# ARKESEL_API_KEY=
# SMS_SENDER_ID=LDSGH
# or Twilio SMS: SMS_PROVIDER=twilio with TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_SMS_FROM=+1...
# WhatsApp (Twilio). Business-initiated messages need an approved template (Content SID):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_WHATSAPP_CONTENT_SID=
