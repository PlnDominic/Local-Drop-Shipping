# ─── Supabase (public, browser-safe) ─────────────────────────────────────────
# The anon key is meant to be public; data access is enforced by RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Backend API (only if/when using the NestJS API layer) ────────────
# Defaults to /api/v1 when unset.
NEXT_PUBLIC_API_URL=https://api.your-domain.com/v1

# ─── Face Verification ────────────────────────────────────────────────
# Choose ONE provider; leave unused ones blank.
# Face++ (https://www.faceplusplus.com/)
FACEPP_API_KEY=your_faceplusplus_api_key
FACEPP_API_SECRET=your_faceplusplus_api_secret
# AWS Rekognition (set to enable)
AWS_REKOGNITION_REGION=
AWS_REKOGNITION_ACCESS_KEY_ID=
AWS_REKOGNITION_SECRET_ACCESS_KEY=
# Azure Face (set to enable)
AZURE_FACE_ENDPOINT=
AZURE_FACE_KEY=
