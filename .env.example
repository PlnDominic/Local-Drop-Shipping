# ─── Supabase (public, browser-safe) ─────────────────────────────────────────
# The anon key is meant to be public; data access is enforced by RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Backend API (only if/when using the NestJS API layer) ────────────────────
# Defaults to /api/v1 when unset.
NEXT_PUBLIC_API_URL=https://api.your-domain.com/v1

# ─── Pre-launch waitlist ─────────────────────────────────────────────────────
# Optional. When set to a future date/time, the homepage shows a launch countdown.
# NEXT_PUBLIC_LAUNCH_DATE=2026-12-01T09:00:00Z
