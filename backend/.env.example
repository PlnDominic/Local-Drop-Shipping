# ─── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# ─── Payments ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
MOMO_SUBSCRIPTION_KEY=your-mtn-momo-subscription-key

# ─── SMS (Hubtel) ──────────────────────────────────────────────────────────────
HUBTEL_CLIENT_ID=your-hubtel-client-id
HUBTEL_CLIENT_SECRET=your-hubtel-client-secret

# ─── Email (SendGrid) ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── WhatsApp Business API ─────────────────────────────────────────────────────
WHATSAPP_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ─── GhanaPost GPS ─────────────────────────────────────────────────────────────
GHANAPOST_API_KEY=your-ghanapost-api-key

# ─── Platform ──────────────────────────────────────────────────────────────────
PLATFORM_FEE_PERCENT=2
